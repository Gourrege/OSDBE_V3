{
  "openapi": "3.0.0",
  "info": {
    "title": "Driver API",
    "version": "1.0.0",
    "description": "API for managing racing drivers, including creation, retrieval, updates, and deletions."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Get all drivers",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "description": "JSON object string for filtering drivers (e.g. {\"nationality\":\"UK\"})",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of drivers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Driver"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter format"
          },
          "500": {
            "description": "Failed to retrieve drivers"
          }
        }
      },
      "post": {
        "summary": "Create a new driver",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDriver"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Driver created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Created a new user with id 653e4c2b1f..."
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Failed to create driver"
          }
        }
      }
    },
    "/{id}": {
      "get": {
        "summary": "Get driver by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Driver found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Driver"
                }
              }
            }
          },
          "404": {
            "description": "Driver not found"
          }
        }
      },
      "put": {
        "summary": "Update driver by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDriver"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Driver updated successfully"
          },
          "400": {
            "description": "Invalid user ID format"
          },
          "404": {
            "description": "Driver not found"
          },
          "500": {
            "description": "Unexpected server error"
          }
        }
      },
      "delete": {
        "summary": "Delete driver by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Driver deleted message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "delete user 653e4c2b1f... from the database"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Driver": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "racingNumber": { "type": "string" },
          "nationality": { "type": "string" },
          "driverImage": { "type": "string", "format": "uri" },
          "driverTeam": { "type": "string" },
          "driverDES": { "type": "string" },
          "wins": { "type": "integer" },
          "podiums": { "type": "integer" },
          "driverWC": { "type": "integer" },
          "dob": { "type": "string", "format": "date" },
          "dateJoined": { "type": "string", "format": "date-time" },
          "lastUpdate": { "type": "string", "format": "date-time" }
        }
      },
      "CreateDriver": {
        "type": "object",
        "required": [
          "name",
          "racingNumber",
          "nationality",
          "driverImage",
          "driverTeam",
          "driverDES"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "racingNumber": { "type": "string", "minLength": 1 },
          "nationality": { "type": "string", "minLength": 1 },
          "driverImage": { "type": "string", "format": "uri" },
          "driverTeam": { "type": "string", "minLength": 1 },
          "driverDES": { "type": "string", "minLength": 1 }
        }
      },
      "UpdateDriver": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "racingNumber": { "type": "string" },
          "nationality": { "type": "string" },
          "driverImage": { "type": "string", "format": "uri" },
          "driverTeam": { "type": "string" },
          "driverDES": { "type": "string" }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
